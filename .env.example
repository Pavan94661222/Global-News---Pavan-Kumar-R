# Copy this file to .env and put a newly generated Gemini API key here.
GEMINI_API_KEY=replace-with-your-rotated-key
GEMINI_MODEL=gemini-3.8-flash

# Optional: override the RapidAPI "Real-Time News Data" backup keys
# (the built-in ones are used when these are left unset).
RAPIDAPI_KEY_1=
RAPIDAPI_KEY_2=
RAPIDAPI_KEY_3=
